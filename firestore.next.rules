// Candidata NÃO publicada: validar no emulador e comparar regras atuais antes de aplicar.
// users/{uid}: dados privados; criação/edição só pelo titular. Exclusão física bloqueada.
// messages: role/text; transactions: type/amount/category/description/date;
// studies: subject/topic/minutes/correct/total/difficulty/reviewDate/original/date;
// memories/diary/tasks: title/category/text/date (+ status para tasks).
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function str(s,n) { return s is string && s.size() <= n; }
  function base(d) {
   return d.createdAt is timestamp && d.createdAt <= request.time
    && (!('updatedAt' in d) || d.updatedAt is timestamp)
    && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is timestamp);
  }
  function valid(k,d) {
   return base(d) && (
    (k == 'messages' && d.keys().hasOnly(['role','text','createdAt','date','updatedAt','deletedAt']) && d.role in ['user','assistant'] && str(d.text,12000)) ||
    (k == 'transactions' && d.keys().hasOnly(['type','amount','category','description','date','createdAt','updatedAt','deletedAt']) && d.type in ['income','expense'] && d.amount is number && d.amount > 0 && d.amount <= 100000000 && str(d.category,200) && str(d.description,6000) && str(d.date,10)) ||
    (k == 'studies' && d.keys().hasOnly(['subject','topic','minutes','correct','total','difficulty','reviewDate','original','date','createdAt','updatedAt','deletedAt']) && str(d.subject,200) && str(d.topic,200) && d.minutes is int && d.minutes > 0 && d.minutes <= 1440 && d.correct is int && d.total is int && d.correct >= 0 && d.total >= d.correct && d.total <= 10000 && d.difficulty in ['fácil','média','difícil'] && str(d.reviewDate,10) && str(d.original,6000) && str(d.date,10)) ||
    (k in ['memories','diary','tasks'] && d.keys().hasOnly(['title','category','text','date','status','createdAt','updatedAt','deletedAt']) && str(d.title,200) && str(d.category,200) && str(d.text,6000) && str(d.date,10) && (k != 'tasks' || d.status in ['pending','done']))
   );
  }
  match /users/{uid}/{kind}/{id} {
   allow read: if owner(uid) && kind in ['messages','transactions','studies','memories','diary','tasks','settings'];
   allow create: if owner(uid) && valid(kind,request.resource.data);
   allow update: if owner(uid) && valid(kind,request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if false;
  }
  match /users/{uid}/settings/profile {
   function validSettings(d) { return d.keys().hasOnly(['nickname','goal','model','useMemory','useHistory','updatedAt']) && str(d.nickname,80) && d.goal is number && d.goal >= 0 && d.goal <= 100000000 && (!('model' in d) || str(d.model,120)) && (!('useMemory' in d) || d.useMemory is bool) && (!('useHistory' in d) || d.useHistory is bool) && d.updatedAt is timestamp; }
   allow create, update: if owner(uid) && validSettings(request.resource.data);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
