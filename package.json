{
  "name": "sigma-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "build:lab": "tsc --noEmit && vite build --config vite.lab.config.ts",
    "build:beta": "tsc --noEmit && vite build --config vite.beta.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "firebase": "^12.0.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "@cloudflare/workers-types": "^4.20251001.0"
  }
}
