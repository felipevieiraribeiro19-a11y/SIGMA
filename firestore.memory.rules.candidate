// DO NOT DEPLOY: deny-direct-write candidate for emulator review; not referenced by firebase.json
// No user-memory functionality is enabled by this file alone.
// Prototype. Standard edition. No application data is available before activation.
// settings/app: timezone (required, fixed string), updatedAt (required server timestamp).
// Access limited to the owner's verified Google identity and own UID path.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isOwner(uid) {
    return request.auth != null
      && request.auth.uid == uid
      && request.auth.token.email == 'felipevieiraribeiro19@gmail.com'
      && request.auth.token.email_verified == true
      && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function isValidSettings(data) {
   return data.keys().hasAll(['timezone', 'updatedAt']) && data.keys().hasOnly(['timezone', 'updatedAt'])
     && data.timezone == 'America/Sao_Paulo' && data.updatedAt is timestamp && data.updatedAt == request.time;
  }
  match /users/{uid}/settings/app {
   allow read: if isOwner(uid);
   allow create, update: if isOwner(uid) && isValidSettings(request.resource.data);
   allow delete: if false;
  }
  // turns: exact original report and assistant answer, immutable, server timestamp.
  function isValidTurn(d) {
   return d.keys().hasAll(['userText','assistantText','createdAt']) && d.keys().hasOnly(['userText','assistantText','createdAt'])
    && d.userText is string && d.userText.size() > 0 && d.userText.size() <= 4000
    && d.assistantText is string && d.assistantText.size() > 0 && d.assistantText.size() <= 16000
    && d.createdAt is timestamp && d.createdAt == request.time;
  }
  match /users/{uid}/turns/{turnId} {
   allow read: if isOwner(uid);
   allow create: if isOwner(uid) && isValidTurn(request.resource.data);
   allow update, delete: if false;
  }

  // CANDIDATE ONLY. Never publish without emulator tests and reviewed rollout.
  // CRITICAL: the browser/mobile app cannot write approved memories directly.
  // A Firebase ID token proves identity, not a click on Confirm or server review.
  // Future persistence MUST use a trusted, authenticated backend that verifies
  // a single-use approval and uses a scoped server-side Google identity.
  match /users/{uid}/personalMemories/{memoryId} {
    allow get, list: if isOwner(uid);
    allow create, update, delete: if false;
  }

  match /{document=**} { allow read, write: if false; }
 }
}
